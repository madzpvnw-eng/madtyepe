{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public profile and synced madtype preferences for an authenticated user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "displayName": {
          "type": "string",
          "maxLength": 120,
          "description": "User display name from Google account."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Profile avatar URL from Google account."
        },
        "theme": {
          "type": "string",
          "enum": ["dark", "light"],
          "description": "Gray Matte (dark) or Cream Soft Matte (light) theme."
        },
        "fontFamily": {
          "type": "string",
          "maxLength": 80,
          "description": "Selected practice font family."
        },
        "wordsToType": {
          "type": "string",
          "enum": ["all", "moderate", "light", "first_letters"],
          "description": "Words-to-type difficulty mode."
        },
        "typingMode": {
          "type": "string",
          "enum": ["wait", "continuous", "line"],
          "description": "Typing progression mode."
        },
        "autoReplay": {
          "type": "string",
          "enum": ["off", "5", "10", "15"],
          "description": "Auto-replay interval while waiting."
        },
        "keySound": {
          "type": "string",
          "enum": ["off", "quiet", "medium", "loud"],
          "description": "Keypress sound effect volume."
        },
        "errorSound": {
          "type": "string",
          "enum": ["off", "error", "beep", "thud"],
          "description": "Error sound effect style."
        },
        "waitForTyping": {
          "type": "boolean",
          "description": "Whether playback pauses at line end until typing completes."
        },
        "soundFx": {
          "type": "boolean",
          "description": "Master toggle for sound effects."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user document was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user document was last updated."
        }
      },
      "required": ["uid", "displayName", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII document storing user email and verification state.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "description": "Authenticated Google email address."
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Whether the Google email is verified."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp."
        }
      },
      "required": ["uid", "email", "emailVerified", "createdAt", "updatedAt"]
    },
    "PracticeSession": {
      "title": "PracticeSession",
      "description": "Completed YouTube lyric typing practice session statistics.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "videoId": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "YouTube video ID."
        },
        "songTitle": {
          "type": "string",
          "maxLength": 200,
          "description": "Title of the practiced track."
        },
        "songArtist": {
          "type": "string",
          "maxLength": 160,
          "description": "Artist or channel name."
        },
        "wpm": {
          "type": "number",
          "description": "Net Words Per Minute achieved."
        },
        "accuracy": {
          "type": "number",
          "description": "Typing accuracy percentage (0-100)."
        },
        "correctChars": {
          "type": "number",
          "description": "Count of correctly typed characters."
        },
        "totalChars": {
          "type": "number",
          "description": "Total characters typed."
        },
        "highestStreak": {
          "type": "number",
          "description": "Highest consecutive correct streak."
        },
        "completedLines": {
          "type": "number",
          "description": "Number of completed lyric lines."
        },
        "totalLines": {
          "type": "number",
          "description": "Total lyric lines in the track."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of session completion."
        }
      },
      "required": [
        "uid",
        "videoId",
        "songTitle",
        "songArtist",
        "wpm",
        "accuracy",
        "correctChars",
        "totalChars",
        "highestStreak",
        "completedLines",
        "totalLines",
        "createdAt"
      ]
    },
    "FavoriteSong": {
      "title": "FavoriteSong",
      "description": "User-bookmarked YouTube song for quick practice.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "videoId": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "YouTube video ID."
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Track title."
        },
        "artist": {
          "type": "string",
          "maxLength": 160,
          "description": "Artist or channel name."
        },
        "duration": {
          "type": "number",
          "description": "Track duration in seconds."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when bookmarked."
        }
      },
      "required": ["uid", "videoId", "title", "artist", "duration", "createdAt"]
    },
    "LoginLog": {
      "title": "LoginLog",
      "description": "Audit record tracking each authenticated Google account that has signed into madtype.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the signed-in user."
        },
        "displayName": {
          "type": "string",
          "maxLength": 120,
          "description": "Display name of the Google account."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "description": "Verified email address of the Google account."
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Whether the Google email is verified."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Avatar URL of the Google account."
        },
        "providerId": {
          "type": "string",
          "maxLength": 64,
          "description": "Auth provider identifier (e.g. google.com)."
        },
        "loginCount": {
          "type": "number",
          "description": "Total number of recorded sign-in sessions."
        },
        "firstLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the user's first recorded login."
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the user's most recent login."
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "emailVerified",
        "photoURL",
        "providerId",
        "loginCount",
        "firstLoginAt",
        "lastLoginAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores each authenticated user's profile and synced madtype preferences."
    },
    "/users/{userId}/private/info": {
      "schema": {
        "$ref": "#/entities/UserPrivateInfo"
      },
      "description": "Isolated PII document storing the user's verified email."
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": {
        "$ref": "#/entities/PracticeSession"
      },
      "description": "Completed typing practice session history owned by the user."
    },
    "/users/{userId}/favorites/{videoId}": {
      "schema": {
        "$ref": "#/entities/FavoriteSong"
      },
      "description": "User's favorite YouTube songs for quick replay."
    },
    "/login_logs/{userId}": {
      "schema": {
        "$ref": "#/entities/LoginLog"
      },
      "description": "Admin-readable audit log of all Google accounts that have ever signed in."
    }
  }
}
